# Copy this file to .env in the project root, then restart the server after edits.
DEEPSEEK_API_KEY=
PORT=3000

# Relative paths are resolved from the project root.
DATA_PATH=data/weave.sqlite

# Optional model settings (uncomment to override defaults).
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
# MODEL_MAX_ATTEMPTS=2
# By default, use deepseek-flash's maximum output: 384K (393216) tokens, including thinking.
# Set MODEL_MAX_TOKENS only to explicitly lower that limit (integer: 1–393216).
# MODEL_MAX_TOKENS=393216
# MODEL_TIMEOUT_MS=180000
